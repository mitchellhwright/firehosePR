{
  "name": "firehosepr",
  "version": "0.1.0",
  "description": "Conservative change planning, balanced test shards, and exact-input CI evidence for fast pull requests.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "bin": { "fpr": "bin/fpr.mjs" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./ci/*": { "types": "./dist/ci/src/*.d.ts", "import": "./dist/ci/src/*.js" }
  },
  "files": ["bin/", "dist/", "README.md", "LICENSE", "docs/configuration.md", "docs/cache-and-evidence.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts ci/tests/*.test.ts",
    "check": "npm run build && npm test && node scripts/audit-export.mjs && node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "typescript": "7.0.2", "@types/node": "26.6.6" },
  "repository": { "type": "git", "url": "git+https://github.com/mitchellhwright/firehosePR.git" },
  "bugs": { "url": "https://github.com/mitchellhwright/firehosePR/issues" },
  "keywords": ["ci", "github-actions", "pull-request", "test-sharding", "merge-queue", "xcode"]
}
